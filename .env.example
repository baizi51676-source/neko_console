# Neko Console 部署配置（复制为 .env 后填写）

# AstrBot 的 WebUI 地址（必填）
#   - 同一个 docker 网络：http://astrbot:6185
#   - 不同机器/网络：http://192.168.1.10:6185
ASTRBOT_BASE=http://astrbot:6185

# 本控制台对外端口
NEKO_PORT=6186

# 侧车访问口令（可留空；设置后首次打开页面需输入）
NEKO_PASSWORD=

# 上游返回超大 JSON 时的代理上限（MB），0 = 不限制
NEKO_MAX_PROXY_MB=6

# 使用的镜像（默认 ghcr.io 官方发布版）
#NEKO_IMAGE=ghcr.io/baizi51676-source/neko_console:latest

# 本地构建时使用的 npm 镜像（仅 docker compose build 生效）
#NPM_REGISTRY=https://registry.npmmirror.com